{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "namespace": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string" }
      }
    },
    "commonLabels": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": { "type": "object" }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string" },
        "automountToken": { "type": "boolean" }
      }
    },
    "networkPolicy": { "$ref": "#/definitions/networkPolicy" },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "data": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "secret": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string" },
        "stringData": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "api": { "$ref": "#/definitions/api" },
    "worker": { "$ref": "#/definitions/worker" },
    "migrate": { "$ref": "#/definitions/migrate" }
  },
  "definitions": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": { "type": "string" },
        "tag": { "type": "string" },
        "pullPolicy": { "type": "string" }
      }
    },
    "probe": {
      "type": "object",
      "additionalProperties": true
    },
    "resources": {
      "type": "object",
      "additionalProperties": true
    },
    "securityContext": {
      "type": "object",
      "additionalProperties": true
    },
    "pdb": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "minAvailable": {
          "oneOf": [
            { "type": "integer", "minimum": 0 },
            { "type": "string" },
            { "type": "null" }
          ]
        },
        "maxUnavailable": {
          "oneOf": [
            { "type": "integer", "minimum": 0 },
            { "type": "string" },
            { "type": "null" }
          ]
        }
      }
    },
    "autoscaling": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "minReplicas": { "type": "integer", "minimum": 1 },
        "maxReplicas": { "type": "integer", "minimum": 1 },
        "targetCPUUtilizationPercentage": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      }
    },
    "topologySpreadConstraints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "maxSkew": { "type": "integer", "minimum": 1 },
        "topologyKey": { "type": "string", "minLength": 1 },
        "whenUnsatisfiable": {
          "type": "string",
          "enum": ["DoNotSchedule", "ScheduleAnyway"]
        }
      }
    },
    "networkPolicyRule": {
      "type": "object",
      "additionalProperties": true
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "allowedEgressTCPPorts": {
          "type": "array",
          "items": { "type": "integer", "minimum": 1, "maximum": 65535 }
        },
        "api": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ingress": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "from": {
                  "type": "array",
                  "items": { "type": "object", "additionalProperties": true }
                }
              }
            },
            "extraEgress": {
              "type": "array",
              "items": { "$ref": "#/definitions/networkPolicyRule" }
            }
          }
        },
        "worker": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "extraEgress": {
              "type": "array",
              "items": { "$ref": "#/definitions/networkPolicyRule" }
            }
          }
        },
        "migrate": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "extraEgress": {
              "type": "array",
              "items": { "$ref": "#/definitions/networkPolicyRule" }
            }
          }
        }
      }
    },
    "api": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "replicas": { "type": "integer", "minimum": 0 },
        "terminationGracePeriodSeconds": { "type": "integer", "minimum": 1 },
        "autoscaling": { "$ref": "#/definitions/autoscaling" },
        "topologySpreadConstraints": { "$ref": "#/definitions/topologySpreadConstraints" },
        "pdb": { "$ref": "#/definitions/pdb" },
        "image": { "$ref": "#/definitions/image" },
        "containerPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "service": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": { "type": "string" },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "targetPort": {
              "oneOf": [
                { "type": "string" },
                { "type": "integer", "minimum": 1, "maximum": 65535 }
              ]
            }
          }
        },
        "podAnnotations": { "type": "object", "additionalProperties": { "type": "string" } },
        "podSecurityContext": { "$ref": "#/definitions/securityContext" },
        "securityContext": { "$ref": "#/definitions/securityContext" },
        "livenessProbe": { "$ref": "#/definitions/probe" },
        "readinessProbe": { "$ref": "#/definitions/probe" },
        "resources": { "$ref": "#/definitions/resources" }
      }
    },
    "worker": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "replicas": { "type": "integer", "minimum": 0 },
        "terminationGracePeriodSeconds": { "type": "integer", "minimum": 1 },
        "autoscaling": { "$ref": "#/definitions/autoscaling" },
        "topologySpreadConstraints": { "$ref": "#/definitions/topologySpreadConstraints" },
        "pdb": { "$ref": "#/definitions/pdb" },
        "image": { "$ref": "#/definitions/image" },
        "podAnnotations": { "type": "object", "additionalProperties": { "type": "string" } },
        "podSecurityContext": { "$ref": "#/definitions/securityContext" },
        "securityContext": { "$ref": "#/definitions/securityContext" },
        "resources": { "$ref": "#/definitions/resources" }
      }
    },
    "migrate": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "serviceAccountName": { "type": "string" },
        "backoffLimit": { "type": "integer", "minimum": 0 },
        "restartPolicy": { "type": "string" },
        "hook": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "weight": { "type": "integer" },
            "deletePolicy": { "type": "string" }
          }
        },
        "image": { "$ref": "#/definitions/image" },
        "podAnnotations": { "type": "object", "additionalProperties": { "type": "string" } },
        "podSecurityContext": { "$ref": "#/definitions/securityContext" },
        "securityContext": { "$ref": "#/definitions/securityContext" },
        "resources": { "$ref": "#/definitions/resources" }
      }
    }
  }
}
