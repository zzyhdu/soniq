# Soniq local development configuration
APP_ENV=development
APP_PUBLIC_URL=http://localhost:8080
API_ADDRESS=:8080

POSTGRES_DSN=postgres://soniq_user:soniq_password@localhost:5432/soniq?sslmode=disable
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=soniq-audio-pipeline

STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=var/uploads

# Future S3-compatible storage provider settings.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=soniq
S3_ACCESS_KEY=soniq_minio_user
S3_SECRET_KEY=soniq_minio_password
S3_FORCE_PATH_STYLE=true

# Default stays fake for local-safe tests and smoke runs.
# To manually call Xiaomi MiMo ASR, copy this file to .env and set:
#   TRANSCRIPTION_PROVIDER=openai_compatible_asr
#   TRANSCRIPTION_API_KEY=<your local key>
TRANSCRIPTION_PROVIDER=fake_transcription
TRANSCRIPTION_BASE_URL=https://api.xiaomimimo.com/v1
TRANSCRIPTION_API_KEY=replace-me
# Optional Xiaomi MiMo alias; TRANSCRIPTION_API_KEY takes precedence when set.
MIMO_API_KEY=replace-me
TRANSCRIPTION_MODEL=mimo-v2.5-asr
TRANSCRIPTION_AUTH_HEADER=api-key
TRANSCRIPTION_LANGUAGE=auto
TRANSCRIPTION_MAX_BASE64_BYTES=10485760

# Aliyun Bailian / DashScope native non-realtime ASR.
# To use it in the worker, set TRANSCRIPTION_PROVIDER=dashscope_asr.
# Switch between paraformer-v2 (default/free quota friendly) and fun-asr.
DASHSCOPE_API_KEY=replace-me
DASHSCOPE_ASR_MODEL=paraformer-v2

# Default stays fake for local-safe tests and smoke runs.
# To manually call Aliyun Bailian / DashScope through the OpenAI-compatible API, set:
#   LLM_PROVIDER=openai_compatible
#   LLM_API_KEY=<your local key> # optional when DASHSCOPE_API_KEY is set
LLM_PROVIDER=fake_llm
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=replace-me
LLM_MODEL=qwen3.7-plus

# When true, the worker deletes the original uploaded audio object after transcription succeeds.
# Normalized audio remains available for downstream summarization/debugging.
PRIVACY_DELETE_ORIGINAL_AUDIO_AFTER_TRANSCRIPTION=false
PRIVACY_ALLOW_EXTERNAL_MODEL_PROVIDERS=true
